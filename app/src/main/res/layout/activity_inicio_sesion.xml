<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_inicio_sesion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/margen_pantalla"
        app:layout_constraintWidth_max="@dimen/ancho_maximo_contenido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_inicio_sesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/ly_cabecera"
                android:layout_width="0dp"
                android:layout_height="@dimen/alto_cabecera"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_volver"
                    android:layout_width="@dimen/alto_area_tactil"
                    android:layout_height="@dimen/alto_area_tactil"
                    android:padding="@dimen/padding_icono_volver"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descripcion_volver"
                    app:srcCompat="@drawable/ic_volver" />
                <TextView
                    android:id="@+id/tv_titulo_inicio_sesion"
                    style="@style/TextoTituloPantalla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:includeFontPadding="false"
                    android:text="@string/titulo_inicio_sesion" />
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_identidad_marca_centro"
                android:layout_width="0dp"
                android:layout_height="@dimen/alto_panel_marca"
                android:background="@drawable/bg_panel_marca"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ly_cabecera">
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guia_marca_fotografia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <LinearLayout
                    android:id="@+id/ly_identidad_davante"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/padding_marca_inicio"
                    android:paddingEnd="@dimen/padding_marca_final"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guia_marca_fotografia"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:id="@+id/tv_nombre_pequeno"
                        style="@style/TextoMarcaPequeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/marca_pequeno" />
                    <ImageView
                        android:id="@+id/iv_logo_davante"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/alto_logo"
                        android:layout_marginTop="@dimen/separacion_marca"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:contentDescription="@string/descripcion_logo"
                        android:src="@drawable/ic_logo_davante" />
                    <TextView
                        android:id="@+id/tv_tipo_tienda"
                        style="@style/TextoTipoTienda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/separacion_marca"
                        android:includeFontPadding="false"
                        android:text="@string/tipo_tienda" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_fotografia_medac"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/descripcion_centro"
                    android:src="@drawable/img_medac_sevilla_este"
                    app:layout_constraintStart_toStartOf="@id/guia_marca_fotografia"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <FrameLayout
                    android:id="@+id/ly_etiqueta_centro"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_rotulo_centro"
                    android:background="@color/acento"
                    app:layout_constraintStart_toStartOf="@id/iv_fotografia_medac"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:id="@+id/tv_nombre_centro"
                        style="@style/TextoNombreCentro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/nombre_centro" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:id="@+id/ly_formulario_accesos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_formulario"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ly_identidad_marca_centro">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_correo_electronico"
                    style="@style/CampoContenedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/correo_etiqueta"
                    app:hintTextAppearance="@style/TextoEtiquetaCorreo">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_correo_electronico"
                        style="@style/TextoCampoCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:paddingStart="@dimen/padding_campo"
                        android:paddingEnd="@dimen/padding_campo"
                        android:hint="@string/correo_hint"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:textColorHint="@color/texto_campo"
                        android:minHeight="@dimen/alto_campo" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_contrasena"
                    style="@style/CampoContenedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/contrasena_etiqueta"
                    app:hintTextAppearance="@style/TextoEtiquetaContrasena"
                    android:layout_marginTop="@dimen/margen_segundo_campo">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_contrasena"
                        style="@style/TextoCampoContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:paddingStart="@dimen/padding_campo"
                        android:paddingEnd="@dimen/padding_campo"
                        android:hint="@string/contrasena_hint"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:textColorHint="@color/texto_campo"
                        android:minHeight="@dimen/alto_campo" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_recuperar_contrasena"
                    style="@style/TextoRecuperarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:text="@string/recuperar_contrasena"
                    android:minHeight="@dimen/alto_area_tactil"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:paddingTop="@dimen/padding_vertical_boton"
                    android:paddingBottom="@dimen/padding_vertical_boton" />
                <LinearLayout
                    android:id="@+id/ly_aceptacion_terminos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/alto_area_tactil"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_aceptar_terminos"
                        android:layout_width="@dimen/alto_area_tactil"
                        android:layout_height="@dimen/alto_area_tactil"
                        android:minWidth="@dimen/sin_espacio"
                        android:minHeight="@dimen/sin_espacio"
                        android:paddingStart="@dimen/padding_control_terminos"
                        android:paddingEnd="@dimen/padding_control_terminos"
                        android:contentDescription="@string/aceptar_terminos"
                        android:button="@drawable/bg_control_terminos"
                        app:buttonCompat="@drawable/bg_control_terminos"
                        app:buttonIcon="@null"
                        app:buttonTint="@null"
                        app:useMaterialThemeColors="false" />
                    <TextView
                        android:id="@+id/tv_texto_terminos"
                        style="@style/TextoTerminos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/separacion_terminos"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:text="@string/aceptar_terminos" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_iniciar_sesion"
                    style="@style/TextoBotonPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/iniciar_sesion"
                    android:minHeight="@dimen/alto_area_tactil"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:paddingTop="@dimen/padding_vertical_boton"
                    android:paddingBottom="@dimen/padding_vertical_boton" />
                <LinearLayout
                    android:id="@+id/ly_separador_accesos"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_separador"
                    android:paddingStart="@dimen/margen_lineas"
                    android:paddingEnd="@dimen/margen_lineas"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants">
                    <View
                        android:id="@+id/v_linea_izquierda"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/grosor_separador"
                        android:layout_weight="1"
                        android:background="@color/borde_control" />
                    <TextView
                        android:id="@+id/tv_o_entra_con"
                        style="@style/TextoSeparador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/separacion_campos"
                        android:includeFontPadding="false"
                        android:text="@string/alternativa_acceso" />
                    <View
                        android:id="@+id/v_linea_derecha"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/grosor_separador"
                        android:layout_weight="1"
                        android:background="@color/borde_control" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_acceder_google"
                    style="@style/TextoBotonGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continuar_google"
                    app:icon="@drawable/ic_google"
                    android:minHeight="@dimen/alto_area_tactil"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:paddingTop="@dimen/padding_vertical_boton"
                    android:paddingBottom="@dimen/padding_vertical_boton" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_acceder_davante"
                    style="@style/TextoBotonDavante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_entre_accesos"
                    android:text="@string/acceder_davante"
                    app:icon="@drawable/ic_davante"
                    android:minHeight="@dimen/alto_area_tactil"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:paddingTop="@dimen/padding_vertical_boton"
                    android:paddingBottom="@dimen/padding_vertical_boton" />
                <LinearLayout
                    android:id="@+id/ly_registro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/alto_area_tactil"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tv_pregunta_registro"
                        style="@style/TextoPrimeraVisita"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/primera_visita" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_crear_cuenta"
                        style="@style/TextoCrearCuenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/separacion_registro"
                        android:text="@string/crear_cuenta"
                        android:minHeight="@dimen/alto_area_tactil"
                        android:maxLines="2"
                        android:singleLine="false"
                        android:paddingTop="@dimen/padding_vertical_boton"
                        android:paddingBottom="@dimen/padding_vertical_boton" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_entrar_sin_sesion"
                    style="@style/TextoSeguirSinSesion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seguir_sin_sesion"
                    android:minHeight="@dimen/alto_area_tactil"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:paddingTop="@dimen/padding_vertical_boton"
                    android:paddingBottom="@dimen/padding_vertical_boton" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
