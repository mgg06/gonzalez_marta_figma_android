<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <solid android:color="@color/fondo" />
                    <stroke android:width="2dp" android:color="@color/acento" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval"><solid android:color="@color/acento" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <solid android:color="@color/fondo" />
            <stroke android:width="2dp" android:color="@color/texto_campo" />
        </shape>
    </item>
</selector>
