<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="@dimen/tamano_control_terminos" android:height="@dimen/tamano_control_terminos" />
                    <solid android:color="@color/fondo" />
                    <stroke android:width="@dimen/grosor_control_terminos" android:color="@color/acento" />
                </shape>
            </item>
            <item android:left="@dimen/inset_marca_terminos" android:top="@dimen/inset_marca_terminos" android:right="@dimen/inset_marca_terminos" android:bottom="@dimen/inset_marca_terminos">
                <shape android:shape="oval"><solid android:color="@color/acento" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="@dimen/tamano_control_terminos" android:height="@dimen/tamano_control_terminos" />
            <solid android:color="@color/fondo" />
            <stroke android:width="@dimen/grosor_control_terminos" android:color="@color/texto_campo" />
        </shape>
    </item>
</selector>
